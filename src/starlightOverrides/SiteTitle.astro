<style is:global>
	@property --asterisk-spin {
		syntax: "<angle>";
		initial-value: 0deg;
		inherits: false;
	}
</style>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: var(--space-150);
		width: max-content;
		color: var(--heading-fill);
		text-decoration: none;
		transition: color 300ms cubic-bezier(0.23, 1, 0.32, 1);
	}
	.site-title:hover {
		color: var(--color-pink-100);
	}
	.logo {
		height: 2.25rem;
		width: auto;
		fill: currentColor;
	}
	.wordmark {
		height: 1rem;
		width: auto;
		fill: currentColor;
	}
	#asterisk {
		transform-origin: 201px 131px;
		transform: rotate(var(--asterisk-spin));
		transition: transform 1.5s cubic-bezier(0.23, 1, 0.32, 1);
	}
	.site-title:hover #asterisk {
		--asterisk-spin: 1turn;
	}
	@media (prefers-reduced-motion: reduce) {
		#asterisk {
			transition: none !important;
		}
	}
</style>
